# ── SenAgro environment ───────────────────────────────
# Local dev: copy to .env.local (Vite exposes only VITE_* to the browser).
# Production: set these in Vercel → Project → Settings → Environment Variables.

# Neon serverless Postgres (Project → Dashboard → Connection string, pooled)
DATABASE_URL=postgresql://user:password@ep-xxxxxxxx.aws.neon.tech/senagro?sslmode=require

# Leave unset for Neon (HTTP driver). Set to "pg" to use a local Postgres over
# TCP, e.g.:
#   docker run -d --name senagro-db -p 5433:5432 -e POSTGRES_PASSWORD=senagro postgres:16
# SENAGRO_DB_DRIVER=pg

# JWT secret for app-level sessions (api/auth) — openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Public base URL (used for checkout return_url)
VITE_APP_URL=http://localhost:5173
APP_URL=https://your-senagro-domain.com

# SasPay (https://app.saspay.me → Développeur)
# Server-side only. NEVER commit the real key.
SASPAY_API_KEY=<your-sas-pay-secret-key>
# Only for a sandbox/stub; production uses https://api.saspay.me/api/v1
# SASPAY_BASE_URL=http://localhost:9999

# Signing secret of the webhook created in the SasPay dashboard
# (Développeur → Webhooks → your endpoint, shown once). Used to verify IPNs.
SASPAY_WEBHOOK_SECRET=your-webhook-signing-secret

# SasPay webhook endpoint to register in the dashboard:
#   https://<your-domain>/api/pay/webhook
# Subscribe to: transaction.success, transaction.failed, transaction.cancelled
