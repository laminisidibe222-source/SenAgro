{
  "name": "senagro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SenAgro — Agricultural intelligence SaaS. Soil, climate and biology analysed to tell you exactly what to plant and where.",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "dev:api": "node --env-file-if-exists=.env.local --env-file-if-exists=.env tools/dev-api.mjs",
    "dev:web": "vite",
    "test:e2e": "node tools/e2e.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.36.4",
    "gsap": "^3.12.5",
    "jsonwebtoken": "^9.0.2",
    "lenis": "^1.1.14",
    "lucide-react": "^0.462.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "three": "^0.169.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.28.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
